// Writes supabase/seed_city_guide.sql from the guide bundled in the app (data/*.ts),
// so the database starts with exactly what the app shows offline.
// Safe to re-run: existing rows are updated. Run: node scripts/generate-guide-seed.mts
import { writeFileSync } from 'node:fs';

import { cities } from '../data/cities.ts';
import { parks } from '../data/parks.ts';
import { seasonGuides } from '../data/seasons.ts';

const text = (value: string | null | undefined) => (value == null ? 'null' : `'${value.replace(/'/g, "''")}'`);
const array = (values: string[]) => `array[${values.map(text).join(', ')}]::text[]`;
const rows = (values: (string | number)[][]) => values.map((v) => `  (${v.join(', ')})`).join(',\n');
const updateAll = (columns: string[]) => columns.map((c) => `${c} = excluded.${c}`).join(', ');

export function cityId(name: string): string {
  return name
    .normalize('NFD')
    // Strip accents (é → e) after splitting letters from their marks.
    .replace(/[̀-ͯ]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}

const cityRows = cities.map((c, i) => [
  text(cityId(c.name)), text(c.name), c.lat, c.lng, text(c.knownFor), text(c.tipTitle), text(c.tipText),
  text(c.bestSeason), array(c.seasons), text(c.nightlifeTip), (i + 1) * 10,
]);
const placeRows = cities.flatMap((c) =>
  c.places.map((p, j) => [text(cityId(c.name)), text(p.name), text(p.kind), text(p.description), (j + 1) * 10]),
);
const parkRows = parks.map((p, i) => [text(p.name), text(p.near), text(p.bestFor), text(p.kind), (i + 1) * 10]);
const seasonRows = seasonGuides.map((g, i) => [
  text(g.season), text(g.label), text(g.months), text(g.experiences), array(g.destinations), (i + 1) * 10,
]);

const sql = `-- Generated by scripts/generate-guide-seed.mts from the app's bundled guide. Safe to re-run.
begin;

insert into public.cities (id, name, lat, lng, known_for, tip_title, tip_text, best_season, seasons, nightlife_tip, sort_order) values
${rows(cityRows)}
on conflict (id) do update set ${updateAll(['name', 'lat', 'lng', 'known_for', 'tip_title', 'tip_text', 'best_season', 'seasons', 'nightlife_tip', 'sort_order'])};

insert into public.places (city_id, name, kind, description, sort_order) values
${rows(placeRows)}
on conflict (city_id, name) do update set ${updateAll(['kind', 'description', 'sort_order'])};

insert into public.parks (name, near, best_for, kind, sort_order) values
${rows(parkRows)}
on conflict (name) do update set ${updateAll(['near', 'best_for', 'kind', 'sort_order'])};

insert into public.seasonal_recommendations (season, label, months, experiences, destinations, sort_order) values
${rows(seasonRows)}
on conflict (season) do update set ${updateAll(['label', 'months', 'experiences', 'destinations', 'sort_order'])};

commit;
`;

writeFileSync(new URL('../supabase/seed_city_guide.sql', import.meta.url), sql);
console.log(`Wrote ${cityRows.length} cities, ${placeRows.length} places, ${parkRows.length} parks, ${seasonRows.length} seasons.`);
